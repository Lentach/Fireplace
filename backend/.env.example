# Copy to .env and fill in values.
# Required for all environments:
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASS=postgres123123
DB_NAME=chatdb

JWT_SECRET=your_jwt_secret_at_least_32_chars

# Self-hosted media (optional — defaults suit local Docker)
MEDIA_BASE_URL=http://localhost:3000
MEDIA_DIR=/app/media

# Firebase Cloud Messaging (push notifications — optional, disabled if not set)
# Paste entire service account JSON as a single line (no newlines):
# FIREBASE_SERVICE_ACCOUNT={"type":"service_account","project_id":"...","private_key":"...","client_email":"..."}
FIREBASE_SERVICE_ACCOUNT=

# Standards-based Web Push (PWA) via VAPID (optional, disabled if not set)
# Generate once (example): npx web-push generate-vapid-keys
WEB_PUSH_VAPID_PUBLIC_KEY=
WEB_PUSH_VAPID_PRIVATE_KEY=
WEB_PUSH_VAPID_SUBJECT=mailto:admin@example.com

# Optional: user id whose devices get a Web Push ping when the landing-page
# contact form (POST /contact) receives a message. Unset = store-only.
CONTACT_NOTIFY_USER_ID=

# Secret key guarding the owner's contact inbox page (/contact/inbox?key=...).
# Generate: openssl rand -hex 32. Unset = inbox disabled (404).
CONTACT_INBOX_KEY=

# Optional (defaults shown):
PORT=3000
NODE_ENV=development
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:8080
