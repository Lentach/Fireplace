# Copy to .env and fill in values.
# Required for all environments:
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASS=your_password
DB_NAME=chatdb

JWT_SECRET=your_jwt_secret_at_least_32_chars

# Self-hosted media (optional — defaults suit local Docker)
MEDIA_BASE_URL=http://localhost:3000
MEDIA_DIR=/app/media

# Firebase Cloud Messaging (push notifications — optional, disabled if not set)
# Paste entire service account JSON as a single line (no newlines):
# FIREBASE_SERVICE_ACCOUNT={"type":"service_account","project_id":"...","private_key":"...","client_email":"..."}
FIREBASE_SERVICE_ACCOUNT=

# Optional (defaults shown):
PORT=3000
NODE_ENV=development
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:8080
