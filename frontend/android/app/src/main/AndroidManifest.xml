<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Explicit, not inherited: release must never depend on a library manifest
         (firebase_messaging) merging INTERNET in. -->
    <uses-permission android:name="android.permission.INTERNET"/>
    <!-- Required for push notifications on Android 13+ -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS"/>
    <!-- allowBackup=false is DUAL-PURPOSE, do not relax it:
         1) Auto-Backup would upload the decrypted-message SharedPreferences cache
            to the user's Google Drive in plaintext.
         2) A backup restored to a new device carries flutter_secure_storage's
            encrypted blob WITHOUT its Android Keystore wrapping key -> permanently
            undecryptable Signal identity (known flutter_secure_storage failure mode).
         dataExtractionRules repeats the exclusion for API 31+ cloud backup AND
         device-to-device transfer, belt-and-suspenders. -->
    <!-- networkSecurityConfig: loopback-only cleartext for just_audio's local
         proxy (sealed voice notes play from memory through 127.0.0.1).
         Everything else keeps the API 28+ cleartext block. -->
    <application
        android:label="Umbra"
        android:name="${applicationName}"
        android:icon="@mipmap/ic_launcher"
        android:allowBackup="false"
        android:fullBackupContent="false"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:networkSecurityConfig="@xml/network_security_config">
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTop"
            android:taskAffinity=""
            android:theme="@style/LaunchTheme"
            android:screenOrientation="portrait"
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|smallestScreenSize|locale|layoutDirection|fontScale|screenLayout|density|uiMode"
            android:hardwareAccelerated="true"
            android:windowSoftInputMode="adjustResize">
            <!-- Specifies an Android theme to apply to this Activity as soon as
                 the Android process has started. This theme is visible to the user
                 while the Flutter UI initializes. After that, this theme continues
                 to determine the Window background behind the Flutter UI. -->
            <meta-data
              android:name="io.flutter.embedding.android.NormalTheme"
              android:resource="@style/NormalTheme"
              />
            <intent-filter>
                <action android:name="android.intent.action.MAIN"/>
                <category android:name="android.intent.category.LAUNCHER"/>
            </intent-filter>
        </activity>
        <!-- FCM default notification icon + accent. Fireplace delivers data-only
             messages rendered via flutter_local_notifications (which sets the
             same small icon per-notification), but these apply if the system
             ever renders an FCM notification directly. Small icon MUST be
             monochrome white-on-transparent. -->
        <meta-data
            android:name="com.google.firebase.messaging.default_notification_icon"
            android:resource="@drawable/ic_stat_umbra" />
        <meta-data
            android:name="com.google.firebase.messaging.default_notification_color"
            android:resource="@color/fireplace_notification_accent" />
        <!-- Don't delete the meta-data below.
             This is used by the Flutter tool to generate GeneratedPluginRegistrant.java -->
        <meta-data
            android:name="flutterEmbedding"
            android:value="2" />
    </application>
    <!-- Required to query activities that can process text, see:
         https://developer.android.com/training/package-visibility and
         https://developer.android.com/reference/android/content/Intent#ACTION_PROCESS_TEXT.

         In particular, this is used by the Flutter engine in io.flutter.plugin.text.ProcessTextPlugin. -->
    <queries>
        <intent>
            <action android:name="android.intent.action.PROCESS_TEXT"/>
            <data android:mimeType="text/plain"/>
        </intent>
    </queries>
</manifest>
