.worktrees/
node_modules/
dist/
.env
.env.staging
*.log
mcp.json

# User uploads (profile pictures)
backend/uploads/

# Jest coverage (npm run test:cov) — local only
backend/coverage/

# Graphify knowledge graph output (graphify update .) — local only
graphify-out/

# Scratch screenshots / screen recordings dropped in the repo root while reviewing UI.
# Root only — real assets live under frontend/assets/ and stay tracked.
/*.jpg
/*.jpeg
/*.png
/*.mp4

# Flutter
frontend/build/
frontend/.dart_tool/
frontend/.packages
frontend/.flutter-plugins
frontend/.flutter-plugins-dependencies

# Git worktrees
.worktrees/

# Jacques AI (exclude from project)
.jacques/

# Firebase — Dart-side options were DELETED (Android/iOS init natively from
# google-services.json / GoogleService-Info.plist; web push is VAPID, not FCM)
frontend/lib/firebase-config.js
frontend/web/firebase-config.js

# Android release keystore — never commit these.
# key.properties.example points storeFile at ../keystore/ relative to app/,
# i.e. frontend/android/keystore/ — BOTH candidate locations stay ignored.
frontend/keystore/
frontend/android/keystore/
frontend/android/key.properties


# Local working artifacts — specs, plans, scratch (kept on disk, not in repo)
# Session summaries ARE COMMITTED. This repo is PRIVATE (verified 2026-07-27 via
# `gh repo view --json isPrivate` -> true; docs previously claimed "public", which was
# wrong). Keeping dated summaries local meant a fresh clone or a second machine saw
# nothing newer than 2026-07-22. The pre-commit secret scan still runs on them — keep
# credentials and third-party PII out regardless of visibility.
docs/superpowers/
.planning/
.tmp/
omp-session*.html

# Local audit report — findings/backlog stay off the remote by choice, not visibility
docs/audit/

# deploy-web.ps1 per-machine config (your VM SSH target) — machine-specific and points at
# infrastructure, so it stays out of the repo on hygiene grounds, not visibility grounds
deploy-web.config.ps1

# Claude Code per-machine permission allow-list. NEVER track this: it is machine-local
# state, it accretes one-shot debugging commands, and it has already leaked a live API
# key into origin/master (CONTEXT7_API_KEY, introduced by fdd3aa2, found 2026-07-27).
# The pre-commit fallback regex cannot catch it, and neither can gitleaks' default
# generic-api-key rule — the JSON-escaped \" breaks the match. Keep it out by rule.
# Glob, not an exact path: a `.bak-*` copy of this file carries the same secrets and
# would otherwise be untracked-but-committable.
.claude/settings.local.json*
