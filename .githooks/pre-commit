#!/bin/sh
# Fireplace pre-commit hook. Activate once per clone:  git config core.hooksPath .githooks
# Bypass in a real emergency with:  git commit --no-verify
# Two gates: (1) secret scan on staged content, (2) LATEST.md 5-entry cap.

set -u
fail=0

# --- Gate 1: secret scan -------------------------------------------------
# Prefer gitleaks if installed (full entropy + rule coverage); else fall back
# to a high-signal regex scan of staged additions. This repo is PRIVATE (verified
# 2026-07-27), so a leak here is not instantly public — but dumps, VM targets and
# tokens still must not enter history. The dev PC HAS gitleaks (8.30.1, verified
# 2026-07-29), so the gitleaks branch is what actually runs there; the regex
# fallback only covers a clone on a machine without it.
if command -v gitleaks >/dev/null 2>&1; then
  if ! gitleaks protect --staged --redact >/dev/null 2>&1; then
    echo "BLOCKED: gitleaks found a secret in staged changes."
    gitleaks protect --staged --redact -v 2>&1 | tail -30
    fail=1
  fi
else
  # Regex fallback: scan only ADDED lines in staged tracked files.
  added=$(git diff --cached --diff-filter=ACM -U0 | grep '^+' | grep -v '^+++')
  # Unambiguous secret shapes (kept tight to avoid false positives).
  hits=$(printf '%s\n' "$added" | grep -nEi \
    -e '-----BEGIN [A-Z ]*PRIVATE KEY-----' \
    -e 'AKIA[0-9A-Z]{16}' \
    -e 'cfat_[A-Za-z0-9_-]{20,}' \
    -e 'gh[porsu]_[A-Za-z0-9]{36,}' \
    -e 'github_pat_[A-Za-z0-9_]{40,}' \
    -e 'xox[baprs]-[A-Za-z0-9-]{10,}' \
    -e '"(private_key|client_secret)"[[:space:]]*:' \
    || true)
  if [ -n "$hits" ]; then
    echo "BLOCKED: possible secret in staged changes (regex fallback; install gitleaks for full coverage):"
    printf '%s\n' "$hits" | head -20
    echo "If this is a false positive, commit with --no-verify."
    fail=1
  fi
fi

# --- Gate 2: LATEST.md budget -------------------------------------------
# Entry COUNT was the wrong unit: five entries passed while the file sat at
# ~8.7k tokens, because one 2026-07-25 entry alone was ~4.8k. Every agent AND
# every subagent reads this file at session start (AGENTS.md step 3), so what
# actually costs us is SIZE. Word budget ~= tokens * 3/4.
LATEST=.cursor/session-summaries/LATEST.md
LATEST_MAX_ENTRIES=5
LATEST_MAX_WORDS=2600   # ~3.5k tokens total
LATEST_MAX_ENTRY_WORDS=700   # ~950 tokens for any single entry
if git diff --cached --name-only | grep -qx "$LATEST"; then
  staged=$(git show ":$LATEST" 2>/dev/null)
  n=$(printf '%s\n' "$staged" | grep -cE '^\*\*Date:\*\*' || echo 0)
  words=$(printf '%s\n' "$staged" | wc -w)
  # Largest single entry: split on the **Date:** markers and take the max.
  biggest=$(printf '%s\n' "$staged" | awk '
    /^\*\*Date:\*\*/ { if (w > m) m = w; w = 0 }
    { w += NF }
    END { if (w > m) m = w; print m }')
  if [ "$n" -gt "$LATEST_MAX_ENTRIES" ]; then
    echo "BLOCKED: $LATEST has $n entries (cap $LATEST_MAX_ENTRIES). Move older entries to their dated files."
    fail=1
  fi
  if [ "$words" -gt "$LATEST_MAX_WORDS" ]; then
    echo "BLOCKED: $LATEST is $words words (cap $LATEST_MAX_WORDS, ~$((words * 4 / 3)) tokens)."
    echo "  Every agent and subagent pays this on read. Summarise older entries down to a"
    echo "  few lines + a pointer; the full text already lives in the dated per-session file."
    fail=1
  fi
  if [ "$biggest" -gt "$LATEST_MAX_ENTRY_WORDS" ]; then
    echo "BLOCKED: $LATEST has a single entry of $biggest words (cap $LATEST_MAX_ENTRY_WORDS)."
    echo "  LATEST is the skim layer, not the archive. See CLAUDE.md 1."
    fail=1
  fi
fi

if [ "$fail" -ne 0 ]; then
  echo "pre-commit: rejected. Fix the above or use --no-verify to override."
  exit 1
fi
exit 0
