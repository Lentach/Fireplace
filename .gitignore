/*.jpg
/*.jpeg
/*.png
/*.mp4

# Flutter
frontend/build/
frontend/.dart_tool/
frontend/.packages
frontend/.flutter-plugins
frontend/.flutter-plugins-dependencies

# Git worktrees
.worktrees/

# Jacques AI (exclude from project)
.jacques/

# Firebase — firebase_secrets.dart is committed with TODO placeholders; do not commit real keys
frontend/lib/firebase-config.js
frontend/web/firebase-config.js

# Android release keystore — never commit these
frontend/keystore/
frontend/android/key.properties


# Local working artifacts — specs, plans, scratch (kept on disk, not in repo)
# Session summaries: LATEST.md is ALWAYS committed (AGENTS.md bootstrap reads it from the repo).
# Dated session files default to LOCAL-ONLY — commit one deliberately via `git add -f`
# only after checking it for secrets/audit content (repo is PUBLIC).
.cursor/session-summaries/*
!.cursor/session-summaries/LATEST.md
docs/superpowers/
.planning/
.tmp/
omp-session*.html

# Local audit report — repo is PUBLIC; keep the findings/backlog off the remote
docs/audit/

# deploy-web.ps1 per-machine config (your VM SSH target) — keep out of the public repo
deploy-web.config.ps1
