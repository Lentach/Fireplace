#!/bin/sh
# Fireplace pre-commit hook. Activate once per clone:  git config core.hooksPath .githooks
# Bypass in a real emergency with:  git commit --no-verify
# Two gates: (1) secret scan on staged content, (2) LATEST.md 5-entry cap.

set -u
fail=0

# --- Gate 1: secret scan -------------------------------------------------
# Prefer gitleaks if installed (full entropy + rule coverage); else fall back
# to a high-signal regex scan of staged additions. This repo is PUBLIC (since
# 2026-08-18), so a leak here is world-readable the moment it is pushed. The dev
# PC HAS gitleaks (8.30.1, verified 2026-09-10), so the gitleaks branch is what
# actually runs there; the regex fallback only covers a clone on a machine
# without it. `gitleaks git --staged` is the current form (`protect` was
# deprecated in 8.19 and kept only as a hidden alias).
if command -v gitleaks >/dev/null 2>&1; then
  if ! gitleaks git --staged --redact >/dev/null 2>&1; then
    echo "BLOCKED: gitleaks found a secret in staged changes."
    gitleaks git --staged --redact -v 2>&1 | tail -30
    fail=1
  fi
else
  # Regex fallback: scan only ADDED lines in staged tracked files.
  added=$(git diff --cached --diff-filter=ACM -U0 | grep '^+' | grep -v '^+++')
  # Unambiguous secret shapes (kept tight to avoid false positives).
  hits=$(printf '%s\n' "$added" | grep -nEi \
    -e '-----BEGIN [A-Z ]*PRIVATE KEY-----' \
    -e 'AKIA[0-9A-Z]{16}' \
    -e 'cfat_[A-Za-z0-9_-]{20,}' \
    -e 'gh[porsu]_[A-Za-z0-9]{36,}' \
    -e 'github_pat_[A-Za-z0-9_]{40,}' \
    -e 'xox[baprs]-[A-Za-z0-9-]{10,}' \
    -e '"(private_key|client_secret)"[[:space:]]*:' \
    || true)
  if [ -n "$hits" ]; then
    echo "BLOCKED: possible secret in staged changes (regex fallback; install gitleaks for full coverage):"
    printf '%s\n' "$hits" | head -20
    echo "If this is a false positive, commit with --no-verify."
    fail=1
  fi
fi

# --- Gate 2: context budget --------------------------------------------------
# scripts/verify-context-budget.mjs, on the STAGED tree: root/tier CLAUDE.md byte
# caps, LATEST.md ≤5 entries × ≤1000 chars and no blockquote banner, new dated
# summaries ≤8 KB with the four required sections. Limits are a ratchet set just
# above the 2026-09-10 post-migration sizes — raise one deliberately, with the
# reason in the commit message, never by trimming a fresh summary. History of
# the 2026-08-14 word-budget removal: docs/agents/workflow-2.0.md §4.
# Falls back to the bare 5-entry count on a machine without node.
LATEST=.cursor/session-summaries/LATEST.md
if command -v node >/dev/null 2>&1 && [ -f scripts/verify-context-budget.mjs ]; then
  if ! node scripts/verify-context-budget.mjs; then
    fail=1
  fi
elif git diff --cached --name-only | grep -qx "$LATEST"; then
  n=$(git show ":$LATEST" 2>/dev/null | grep -cE '^\*\*Date:\*\*' || echo 0)
  if [ "$n" -gt 5 ]; then
    echo "BLOCKED: $LATEST has $n dated entries (cap 5). Put yours on top, delete the oldest."
    fail=1
  fi
fi

if [ "$fail" -ne 0 ]; then
  echo "pre-commit: rejected. Fix the above or use --no-verify to override."
  exit 1
fi
exit 0
