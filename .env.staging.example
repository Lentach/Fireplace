# Template for .env.staging (gitignored) — used by staging.ps1 / docker-compose.staging.yml.
# `staging.ps1 up` copies this on first run and replaces JWT_SECRET with a random value.
#
# EVERYTHING here is deliberately fake:
# - JWT_SECRET must NOT be the production secret (staging would mint valid prod tokens).
# - VAPID keys are non-functional placeholders; backend logs "Web Push VAPID init
#   failed" and runs with push disabled — expected and harmless for staging.
JWT_SECRET=REPLACED_ON_FIRST_RUN_BY_STAGING_PS1
ALLOWED_ORIGINS=http://localhost:3100
MEDIA_BASE_URL=http://localhost:3100
WEB_PUSH_VAPID_PUBLIC_KEY=staging-dummy-not-a-real-key
WEB_PUSH_VAPID_PRIVATE_KEY=staging-dummy-not-a-real-key
WEB_PUSH_VAPID_SUBJECT=mailto:staging@example.invalid
